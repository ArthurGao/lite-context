# Copy to .env (gitignored) and fill in. Only the PostgreSQL parts (extra `pg`) read these.
# The transcript store and `litecontext migrate`:
LITECONTEXT_DATABASE_URL=postgresql://lite_context:<password>@localhost:5432/lite_context
# The tests: they use only the schema lite_context_test in this database, dropped and recreated.
LITECONTEXT_TEST_DATABASE_URL=postgresql://lite_context:<password>@localhost:5432/lite_context
